{
  "name": "mp-taro-kit",
  "version": "0.0.5",
  "description": "基于 Taro + React 的小程序基础库（kit）：UI 容器能力与通用操作功能封装（占位发布，API 未定）",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./design": {
      "types": "./dist/design/index.d.ts",
      "import": "./dist/design/index.js",
      "require": "./dist/design/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.cjs"
    },
    "./ui/*": {
      "types": "./dist/ui/*/index.d.ts",
      "import": "./dist/ui/*/index.js",
      "require": "./dist/ui/*/index.cjs"
    },
    "./ui/*/style": "./dist/ui/*/style/index.css",
    "./styles/tokens": "./dist/styles/tokens.css",
    "./styles/theme-light": "./dist/styles/theme-light.css",
    "./styles/theme-dark": "./dist/styles/theme-dark.css",
    "./styles/theme-auto": "./dist/styles/theme-auto.css",
    "./styles/theme-runtime": "./dist/styles/theme-runtime.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "node scripts/check.mjs && node --test tests/*.test.mjs",
    "guard": "node scripts/check.mjs --release"
  },
  "peerDependencies": {
    "@tarojs/components": ">=4.0.0",
    "@tarojs/taro": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cq-guojia/mp-taro-kit.git"
  },
  "keywords": [
    "taro",
    "weapp",
    "mini-program",
    "ui"
  ],
  "devDependencies": {
    "@tarojs/components": "^4.3.2",
    "@types/react": "^18.3.31",
    "sass": "^1.107.1",
    "typescript": "^5.9.3"
  }
}
